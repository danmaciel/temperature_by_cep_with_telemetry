FROM golang:1.24-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /service ./internal/infra/server/service_b

FROM alpine:3.21
RUN apk --no-cache add ca-certificates && addgroup -S app && adduser -S app -G app
COPY --from=build /service /usr/local/bin/service
USER app
EXPOSE 8181
STOPSIGNAL SIGTERM
CMD ["/usr/local/bin/service"]
